# Live verification targets only. Copy to .env (ignored) and edit for your setup.
# Run scripts from the repository root, or pass --env /path/to/your/private.env.
# Use simple KEY=value entries; no shell commands or variable expansion.
POKO_TEST_DEVICE_URL=http://192.168.1.50
POKO_TEST_SERVER_URL=https://poko.example.com
POKO_TEST_ORIGIN_URL=http://127.0.0.1:8765
# Relative paths are resolved against this .env file's directory.
# This directory contains admin-password, device-token, device-admin-password.
POKO_TEST_SECRETS_DIR=/etc/poko
POKO_TEST_EXPECTED_VERSION=v2.4.0
# Optional live playback check: stops current playback and uses your library.
# Requires at least one song and a video longer than 30 seconds.
POKO_TEST_PLAYBACK=0
# Optional browser-session check may reboot the device when explicitly enabled.
POKO_TEST_REBOOT=0
